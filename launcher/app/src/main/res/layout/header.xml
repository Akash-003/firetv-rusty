<!-- clipChildren off here and on the pill row: a focused pill scales up past the row's edge -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:clipChildren="false"
    android:layout_height="540dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="34dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/greeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:letterSpacing="0.28"
            android:textAllCaps="true"
            android:textColor="#80FFFFFF"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextClock
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm"
                android:format24Hour="H:mm"
                android:includeFontPadding="false"
                android:textColor="#F2FFFFFF"
                android:textSize="64sp" />

            <View
                android:layout_width="1dp"
                android:layout_height="34dp"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:background="#33FFFFFF" />

            <TextClock
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="EEEE d MMMM"
                android:format24Hour="EEEE d MMMM"
                android:letterSpacing="0.2"
                android:textAllCaps="true"
                android:textColor="#80FFFFFF"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Fixed width, right-aligned: a pill widening to show its label grows leftwards without moving the row -->
    <LinearLayout
        android:id="@+id/pills"
        android:layout_width="520dp"
        android:clipChildren="false"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:gravity="end"
        android:layout_marginTop="46dp"
        android:layout_marginEnd="28dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/pill_live"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="18dp"
            android:background="@drawable/pill_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_live_tv" />

            <TextView
                android:id="@+id/live_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:paddingEnd="4dp"
                android:includeFontPadding="false"
                android:text="Live TV"
                android:textColor="#E6FFFFFF"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pill_wifi"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/pill_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_wifi" />

            <TextView
                android:id="@+id/wifi_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="4dp"
                android:includeFontPadding="false"
                android:visibility="gone"
                android:layout_marginStart="10dp"
                android:ellipsize="end"
                android:maxWidth="200dp"
                android:singleLine="true"
                android:textColor="#E6FFFFFF"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pill_settings"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="18dp"
            android:background="@drawable/pill_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_settings" />

            <TextView
                android:id="@+id/settings_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="4dp"
                android:includeFontPadding="false"
                android:visibility="gone"
                android:layout_marginStart="10dp"
                android:text="Settings"
                android:textColor="#E6FFFFFF"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/hero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="154dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:textColor="#F2FFFFFF"
        android:textSize="44sp" />

    <LinearLayout
        android:id="@+id/dock"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_gravity="bottom"
        android:layout_marginBottom="36dp"
        android:background="@drawable/band_bg"
        android:orientation="horizontal" />
</FrameLayout>
